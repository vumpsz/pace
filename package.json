{
  "name": "pace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "app:start": "vite build && electron .",
    "app:build": "vite build && electron-builder --win --config electron-builder.cjs",
    "icons": "node scripts/make-icon.mjs",
    "app:build:local": "vite build && electron-builder --win --config electron-builder.cjs --config.directories.output=%LOCALAPPDATA%/pace-release"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "productName": "Pace",
  "description": "Pace: local personal finance and investment tracker",
  "author": "Pace",
  "main": "electron/main.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vumpsz/pace.git"
  },
  "homepage": "https://github.com/vumpsz/pace#readme",
  "bugs": {
    "url": "https://github.com/vumpsz/pace/issues"
  }
}